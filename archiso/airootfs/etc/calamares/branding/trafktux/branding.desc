---
componentName: trafktux

welcomeStyleCalamares: true
welcomeExpandingLogo:  true

windowExpanding: normal
windowSize: 800px,520px

strings:
  productName:         "TrafkTux"
  shortProductName:    "TrafkTux"
  version:             "2026.07"
  shortVersion:        "2026.07"
  versionedName:       "TrafkTux 2026.07"
  shortVersionedName:  "TrafkTux 2026.07"
  bootloaderEntryName: "TrafkTux"
  productUrl:          "https://trafkhop-entertainment.github.io/TrafkSite"
  supportUrl:          "https://trafkhop-entertainment.github.io/TrafkSite"

images:
  productLogo:    "logo.png"
  productIcon:    "logo.png"
  productWelcome: "welcome.png"

slideshow: "show.qml"
slideshowAPI: 2

# WICHTIG: Diese vier Namen (PascalCase!) sind die EINZIGEN, die Calamares
# 3.4.2 tatsaechlich erkennt - direkt aus dem Branding::StyleEntry-Enum in
# src/libcalamaresui/Branding.cpp verifiziert (validateStyleEntries baut
# seine Vergleichsliste per QMetaEnum::valueToKey() aus genau diesem Enum).
# Die vorherige Version mit lowercase-Namen ("sidebarBackground" usw.) kam
# aus einer AELTEREN Calamares-Doku/Version und wird hier als "Unknown
# branding *style* entry" verworfen - bitte NICHT wieder auf lowercase
# aendern.
style:
  SidebarBackground:         "#23163B"
  SidebarText:               "#fffdf5"
  SidebarBackgroundCurrent:  "#fff495"
  SidebarTextCurrent:        "#1A0D34"
