#%PAM-1.0
#
# TrafkTux: erzwingt die Passwort-Policy aus /etc/security/pwquality.conf
# (min. 12 Zeichen, min. 3 von 4 Zeichenklassen) bei jeder Passwort-
# Aenderung via "passwd". "requisite" statt "required" bei
# pam_pwquality, damit bei einem zu schwachen Passwort sofort
# abgebrochen wird, statt trotzdem noch pam_unix.so zu durchlaufen.

password requisite pam_pwquality.so
password required pam_unix.so sha512 shadow use_authtok
