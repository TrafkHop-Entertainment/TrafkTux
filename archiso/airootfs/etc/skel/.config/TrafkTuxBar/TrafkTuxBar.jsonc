// ═══════════════════════════════════════════════════════════
//  TrafkTuxBar.jsonc
//  Ersetzt waybar/config.jsonc + style.css komplett.
//
//  Pfad: ~/.config/TrafkTuxBar/TrafkTuxBar.jsonc
//  Alle Bild-Assets liegen in /tmp/. Blasen-Bilder: TrafkBubble2.png =
//  Hintergrund/"hinten" + TrafkBubble1.png = Vordergrund-Overlay/"vorne"
//  (dieselben beiden, die WidgetsDaemon.py schon benutzt), PLUS
//  TrafkBubbleGlow2.png/TrafkBubbleGlow1.png als deren Hover-Varianten
//  (gibt's in WidgetsDaemon.py nicht, hier aber schon immer vorgesehen).
//  Siehe README.md.
//
//  WICHTIG - "icon": die Werte unten sind freedesktop-Standardnamen
//  als Platzhalter. Ersetze sie durch die tatsaechlichen Namen aus
//  deinem Clay-Icon-Pack (z.B. mit `gtk3-icon-browser` durchsuchen,
//  oder in den .svg/.png-Dateinamen des Packs nachsehen - Icon-Packs
//  benennen z.B. "app-launcher" statt "view-app-grid" o.ae.).
// ═══════════════════════════════════════════════════════════
{
    "position": "bottom",
    // War 180 (siehe alter Kommentar unten zu top_slice/bottom_slice) -
    // das war eine falsche Abwaegung: klassisches 9-Slice zwang die Bar
    // auf mind. 172px, damit die Rundung nicht verzerrt. Der Nine-Slice-
    // Code skaliert die Ecken jetzt UNIFORM (Breite+Hoehe im selben
    // Faktor) statt sie 1:1 zu erzwingen - die Rundung wird bei einer
    // kuerzeren Bar einfach proportional kleiner, NICHT verzerrt. Damit
    // ist jede Hoehe hier sicher moeglich; 68 ist eine normale
    // Taskbar-Groessenordnung.
    "height": 68,
    "exclusive_zone": false,
    // Abstand links/rechts, bevor die erste/letzte Modul-Blase beginnt -
    // soll erst NACH der Eckenrundung der Bar anfangen (nicht mehr direkt
    // am Rand kleben wie vorher). left_slice/right_slice oben sind 220 bei
    // 1920px Bildbreite - bei 68px Bar-Hoehe skaliert die Rundung uniform
    // mit runter, 46px hier ist ein guter Startwert dafuer. Bei Bedarf
    // direkt hier anpassen, ohne neu zu kompilieren.
    "edge_margin": 34,

    // Mehrere Monitore: es gibt immer nur EINE Bar. Leer lassen = sie folgt
    // dem Cursor und erscheint an dem Monitor, an dessen Rand du die Maus
    // hinbewegst (samt Rand-Sensor und Tastatur-Offset). Ein Name (z.B.
    // "eDP-1", herausfinden mit `hyprctl monitors`, Feld "name") pinnt die
    // Bar dauerhaft auf diesen Monitor.
    "monitor": "",

    // Center-Modul (offene Fenster): wie viel von der LOGISCHEN (schon
    // durch den jeweiligen Skalierungsfaktor geteilten) Monitor-Breite
    // maximal fuer die Fenster-Reihe verwendet wird, bevor der Rest auf
    // eine neue Zeile/Seite umbricht. 0.30 = 30% der Bildschirmbreite -
    // dadurch automatisch aufloesungs-/skalierungsunabhaengig statt
    // eines fest verdrahteten Pixelwerts (der Grund, warum bei 1080p+2x
    // Fenster einfach nicht mehr angezeigt wurden).
    "center_width_fraction": 0.30,

    "bar_background": {
        "image": "/tmp/Bar.png",
        // Breite der linken/rechten Ecke IM QUELLBILD (Pixel) - wird
        // beim Zeichnen uniform mitskaliert, siehe Kommentar oben zu
        // "height". Per Pixel-Analyse bestaetigt: die Rundung endet bei
        // x=220 bzw. beginnt bei x=1700 (von 1920px Gesamtbreite).
        "left_slice": 220,
        "right_slice": 220
    },

    "bubble": {
        // FIX ("bubble-normal.png/bubble-selected.png gibt's nicht mehr,
        // Bar startet nicht"): jetzt die 4 neuen Bilder, genau wie in
        // WidgetsDaemon.py (BUBBLE_PATH/OVERLAY_PATH dort) fuer die
        // Normal-Varianten - TrafkBubble2 als Hintergrund ("hinten"),
        // TrafkBubble1 als Vordergrund-Overlay ("vorne", liegt ueber
        // Icon/Text) - PLUS die beiden "Glow"-Hover-Bilder dazu, die es
        // nur hier (nicht in WidgetsDaemon.py) gibt.
        "bg_normal": "/tmp/TrafkBubble2.png",
        "bg_hover": "/tmp/TrafkBubbleGlow2.png",
        "fg_normal": "/tmp/TrafkBubble1.png",
        "fg_hover": "/tmp/TrafkBubbleGlow1.png",
        "transition_ms": 220,
        "min_size": 26,
        "padding": 7,
        "margin": 5
    },

    "icon_theme": "Clay",
    "icon_size": 20,


    "text_color": "#fff495",
    "text_color_hover": "#c8b800",

    "autohide": {
        "enabled": true,
        // War vorher 5px - zusammen mit dem jetzt gefixten reserved-
        // Zonen-Bug (siehe README "Debugging") reicht das eigentlich,
        // aber ein paar Pixel Puffer schaden nicht fuer echte Maus-
        // bewegung.
        "trigger_px": 15,
        "hide_px": 65,
        "touch_timeout_sec": 5,
        // War 220 - zusammen mit den jetzt schnelleren Poll-Intervallen
        // (SLOW/MID/FAST_POLL_MS im Code, 60/28/12ms) UND der neuen
        // ease-out-back-Kurve fuers Zeigen (kleiner bewusster Overshoot -
        // der "Bounce") fuehlt sich das jetzt insgesamt viel zuegiger an,
        // auch bei gleicher oder sogar kuerzerer Dauer wie vorher.
        // Kleiner drehen: 150-170 wirkt noch knackiger, aber der Bounce braucht
        // etwas Luft, um ueberhaupt sichtbar zu sein - unter ~150 wird er
        // kaum noch wahrgenommen.
        "slide_ms": 265,
        // Wie weit der unsichtbare Kantensensor ueber den Bildschirmrand
        // hinausragt (in Pixeln, negativer Rand). Erleichtert das Aufrufen
        // der Bar bei Monitoren ueber anderen Monitoren erheblich, weil die
        // Maus am oberen Rand des darunterliegenden Monitors sofort den
        // Sensor trifft. Bei gesperrter Bar (bar-lock) hat das keinen Effekt.
        // 0 = deaktiviert (altes Verhalten). Standard: 15.
        "edge_overhang_px": 15
    },

    "modules_left": [
        {
            "id": "appmenu",
            "icon": "view-app-grid-symbolic",
            "tooltip": "App Launcher",
            "on_click": "$HOME/.config/TrafkTuxLauncher/TrafkTuxLauncher --show AppLauncher && bash ~/.config/hypr/soundctl.sh click &"
        },
        {
            "id": "workspaces-view",
            "icon": "view-grid-symbolic",
            "tooltip": "Workspace Overview",
            "on_click": "hyprctl eval 'hl.plugin.hyprexpo.expo(\"toggle\")' ; hyprctl eval 'hl.dispatch(hl.dsp.submap(\"hyprexpo\"))' ; bash ~/.config/hypr/soundctl.sh click &"
        },
        {
            "id": "powermenu",
            "icon": "system-shutdown-symbolic",
            "tooltip": "Power Menu",
            "on_click": "$HOME/.config/TrafkTuxLauncher/TrafkTuxLauncher --show PowerMenu && bash ~/.config/hypr/soundctl.sh click &"
        },
        {
            // Trennt den festen 3er-Cluster (appmenu/workspaces-view/
            // powermenu) optisch von den gepinnten Apps darunter/danach.
            "type": "spacer",
            "width": 28
        },
        {
            // Gepinnte Apps: "visible_count" Stueck sind immer sichtbar,
            // der Rest bricht in eine neue Zeile um; die Pfeile daneben
            // blaettern zwischen den Zeilen (Mausrad ueber den Icons auch).
            // Standard 3 - hier frei einstellbar, unabhaengig von
            // Aufloesung/Skalierung.
            "id": "pinned",
            "type": "button_row",
            "visible_count": 3,
            "items": [
                {
                    "id": "shortcut-kitty",
                    "icon": "utilities-terminal-symbolic",
                    "tooltip": "Xfce4 Terminal",
                    "on_click": "setsid xfce4-terminal && bash ~/.config/hypr/soundctl.sh click &"
                },
                {
                    "id": "shortcut-thunar",
                    "icon": "system-file-manager-symbolic",
                    "tooltip": "Thunar",
                    "on_click": "setsid thunar && bash ~/.config/hypr/soundctl.sh click &"
                },
                {
                    "id": "shortcut-firefox",
                    "icon": "firefox",
                    "tooltip": "Firefox",
                    "on_click": "setsid firefox && bash ~/.config/hypr/soundctl.sh click &"
                }
            ]
        }
    ],

    "modules_center": [
        {
            // Zeigt nur den AKTIVEN Workspace als Zahlen-Blase (Pfeile
            // daneben wechseln den Workspace) plus die offenen Fenster
            // DIESES Workspace. Wie viele davon pro Zeile passen, wird
            // automatisch aus der Monitor-Breite und dem Skalierungsfaktor
            // berechnet (siehe "center_width_fraction" ganz oben) - ein
            // eigener Wert hier ist nicht mehr noetig.
            "id": "workspaces",
            "type": "hyprland_workspaces"
        }
    ],

    "modules_right": [
        {
            "id": "tray",
            "type": "tray"
        },
        {
            "id": "clock",
            "type": "clock",
            "format": "%H:%M",
            "format_alt": "%d.%m.%Y",
            "on_click": "socat - UNIX-CONNECT:/tmp/wb-daemon.sock <<< clock"
        },
        {
            // "visible_count" Widgets sind immer sichtbar, der Rest
            // bricht in eine neue Zeile um; die Pfeile daneben blaettern
            // zwischen den Zeilen (Mausrad ueber den Icons auch). Standard
            // 3 - hier frei einstellbar.
            "id": "other-widgets",
            "type": "widget_grid",
            "visible_count": 3,
            "items": [
                {
                    "id": "volume",
                    "icon": "audio-volume-high-symbolic",
                    "tooltip": "Volume & Audio",
                    "on_click": "socat - UNIX-CONNECT:/tmp/wb-daemon.sock <<< volume"
                },
                {
                    "id": "network",
                    "icon": "network-wireless-symbolic",
                    "tooltip": "Netzwerk / Wi-Fi",
                    "on_click": "socat - UNIX-CONNECT:/tmp/wb-daemon.sock <<< network"
                },
                {
                    "id": "bluetooth",
                    "icon": "bluetooth-symbolic",
                    "tooltip": "Bluetooth",
                    "on_click": "socat - UNIX-CONNECT:/tmp/wb-daemon.sock <<< bluetooth"
                },
                {
                    "id": "brightness",
                    "icon": "display-brightness-symbolic",
                    "tooltip": "Helligkeit & Nachtlicht",
                    "on_click": "socat - UNIX-CONNECT:/tmp/wb-daemon.sock <<< brightness"
                },
                {
                    "id": "akku",
                    "icon": "battery-good-symbolic",
                    "tooltip": "Akku-Info",
                    "on_click": "socat - UNIX-CONNECT:/tmp/wb-daemon.sock <<< akku"
                },
                {
                    "id": "osk",
                    "icon": "input-keyboard-symbolic",
                    "tooltip": "Bildschirmtastatur",
                    "exec_cmd": "pgrep -x wvkbd-mobintl >/dev/null && echo '{\"class\":\"active\"}' || echo '{\"class\":\"inactive\"}'",
                    "exec_interval_sec": 2,
                    "exec_return_json": true,
                    "on_click": "(pgrep -x wvkbd-mobintl >/dev/null && pkill -x wvkbd-mobintl || setsid wvkbd-mobintl -L 300); bash ~/.config/hypr/soundctl.sh toggle &"
                }
            ]
        },
        {
            "id": "settings",
            "icon": "preferences-system-symbolic",
            "tooltip": "Einstellungen",
            "on_click": "socat - UNIX-CONNECT:/tmp/wb-daemon.sock <<< settings"
        }
    ]
}
