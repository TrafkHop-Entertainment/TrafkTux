<?xml version="1.0" encoding="UTF-8"?>
<actions>
	<action>
	<icon>utilities-terminal</icon>
<name>Open Terminal Here</name>
<submenu></submenu>
<unique-id>1782127582967189-1</unique-id>
<command>xfce4-terminal --working-directory=%f</command>
<description>Example for a custom action</description>
<range></range>
<patterns>*</patterns>
<startup-notify/>
<directories/>
</action>
<action>
<icon>emblem-symbolic-link</icon>
<name>Symlink: Quelle merken</name>
<submenu></submenu>
<unique-id>1790102755330374-1</unique-id>
<command>bash ~/.config/hypr/SymlinkShortcut.sh source %f</command>
<description>Merkt die markierte Datei/den Ordner als Symlink-Quelle</description>
<range></range>
<patterns>*</patterns>
<directories/>
<audio-files/>
<image-files/>
<other-files/>
<text-files/>
<video-files/>
</action>
<action>
<icon>emblem-symbolic-link</icon>
<name>Symlink: hier erstellen</name>
<submenu></submenu>
<unique-id>1790102755330375-2</unique-id>
<command>bash ~/.config/hypr/SymlinkShortcut.sh paste %d</command>
<description>Erstellt im aktuellen Ordner einen relativen Symlink auf die gemerkte Quelle</description>
<range></range>
<patterns>*</patterns>
<directories/>
<audio-files/>
<image-files/>
<other-files/>
<text-files/>
<video-files/>
</action>
<action>
<icon>emblem-symbolic-link</icon>
<name>Symlink: zum Verschieben markieren</name>
<submenu></submenu>
<unique-id>1790102755330376-3</unique-id>
<command>bash ~/.config/hypr/SymlinkShortcut.sh move %f</command>
<description>Merkt den markierten Symlink zum Verschieben (danach im Zielordner "Symlink: hier erstellen" ausführen)</description>
<range></range>
<patterns>*</patterns>
<directories/>
<audio-files/>
<image-files/>
<other-files/>
<text-files/>
<video-files/>
</action>
<action>
<icon>emblem-symbolic-link</icon>
<name>Symlink: Ordner reparieren</name>
<submenu></submenu>
<unique-id>1790102755330377-4</unique-id>
<command>bash ~/.config/hypr/SymlinkShortcut.sh repair %d</command>
<description>Repariert kaputte relative Symlinks im aktuellen Ordner (Best Effort, sucht per Dateiname unter $HOME)</description>
<range></range>
<patterns>*</patterns>
<directories/>
<audio-files/>
<image-files/>
<other-files/>
<text-files/>
<video-files/>
</action>
</actions>
