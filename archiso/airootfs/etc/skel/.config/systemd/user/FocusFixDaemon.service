[Unit]
Description=Focus-Fix Daemon (Workaround fuer Hyprland Issue #9326 / xfdesktop Fokus-Grab, C-Version)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.config/waybar/Scripts/FocusFixDaemon
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
