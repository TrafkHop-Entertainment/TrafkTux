[Unit]
Description=SoundCenter — persistenter PipeWire-Systemsound-Daemon
After=pipewire.service wireplumber.service pipewire.socket
Requires=pipewire.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
#
# %h = systemd-Specifier für das Home-Verzeichnis des jeweiligen Users
# (siehe man systemd.unit, Abschnitt "Specifiers") - wird zur Laufzeit für
# JEDEN User korrekt aufgelöst, nicht fest auf einen Namen einkompiliert.
# Bloße Namen ("ExecStart=SoundDaemon") würden NUR gehen, wenn die Datei
# in einem von systemds fest einkompilierten Standardverzeichnissen liegt
# (/usr/bin, /usr/local/bin, ...) - ~/.config/hypr gehört nicht dazu.
ExecStart=%h/.config/hypr/SoundDaemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=1
# journald hat bei dir nachweislich nichts für diesen Dienst aufgezeichnet
# (mehrfach "No entries", auch direkt nach Neustart) - Ursache unklar,
# aber für uns gerade unwichtig: schreibt jetzt stattdessen direkt in eine
# normale Datei, komplett an journald vorbei.
StandardOutput=append:/tmp/SoundCenter.log
StandardError=append:/tmp/SoundCenter.log

[Install]
WantedBy=default.target
