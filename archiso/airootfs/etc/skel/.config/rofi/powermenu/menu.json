{
  "name": "root",
  "type": "folder",
  "children": [
    {
      "name": "Close",
      "type": "close-prev-window",
      "icon": "window-close"
    },
    {
      "name": "Minimize",
      "type": "action",
      "icon": "window-minimize",
      "exec": "hyprland-minimizer"
    },
    {
      "name": "Pin",
      "type": "action",
      "icon": "pin",
      "exec": "~/.config/hypr/pip.sh"
    },
    {
      "name": "Swap with Master",
      "type": "action",
      "icon": "view-refresh",
      "exec": "hyprctl dispatch 'hl.dsp.layout(\"swapwithmaster\", \"master\")'"
    },
    {
      "name": "Border Fullscreen",
      "type": "action",
      "icon": "view-fullscreen",
      "exec": "hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = 1 })'"
    },
    {
      "name": "Exclusive Fullscreen",
      "type": "action",
      "icon": "view-fullscreen",
      "exec": "hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = 0 })'"
    },
    {
      "name": "Layout: Master",
      "type": "action",
      "icon": "view-grid",
      "exec": "bash -c 'bash ~/.config/hypr/layout_switcher.sh master; notify-send \"Layout\" \"Master\"'"
    },
    {
      "name": "Layout: Dwindle",
      "type": "action",
      "icon": "view-grid",
      "exec": "bash -c 'bash ~/.config/hypr/layout_switcher.sh dwindle; notify-send \"Layout\" \"Dwindle\"'"
    },
    {
      "name": "Layout: Scroller",
      "type": "action",
      "icon": "view-continuous",
      "exec": "bash -c 'bash ~/.config/hypr/layout_switcher.sh scroller; notify-send \"Layout\" \"Scroller\"'"
    },
    {
      "name": "Layout: Floating",
      "type": "action",
      "icon": "preferences-system-windows",
      "exec": "bash -c 'bash ~/.config/hypr/layout_switcher.sh floating; notify-send \"Layout\" \"Floating\"'"
    },
    {
      "name": "Layout: Bigscreen",
      "type": "action",
      "icon": "view-fullscreen",
      "exec": "bash -c 'bash ~/.config/hypr/layout_switcher.sh bigscreen; notify-send \"Layout\" \"Bigscreen\"'"
    },
    {
      "name": "Lock",
      "type": "action",
      "icon": "system-lock-screen",
      "exec": "hyprlock"
    },
    {
      "name": "Suspend",
      "type": "action",
      "icon": "system-suspend",
      "exec": "hyprlock & sleep 1 && systemctl suspend"
    },
    {
      "name": "Shutdown",
      "type": "action",
      "icon": "system-shutdown",
      "exec": "systemctl poweroff"
    },
    {
      "name": "Reboot",
      "type": "action",
      "icon": "system-reboot",
      "exec": "systemctl reboot"
    },
    {
      "name": "Logout",
      "type": "action",
      "icon": "system-log-out",
      "exec": "hyprctl dispatch 'hl.dsp.exit()'"
    },
    {
      "name": " ",
      "type": "placeholder"
    }
  ]
}
