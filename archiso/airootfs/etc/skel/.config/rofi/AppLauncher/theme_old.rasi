/**
 * Bubble Launcher Theme — 5×3 Grid, touch-freundlich
 *
 * Spalte 1-3 (nur Wurzelebene): 3×3-Ordner-Raster ("1 System" ... "9 Drivers")
 * Spalte 4   (nur Wurzelebene): Other / All Apps / App Packages
 * Spalte 5   (alle Ebenen):     Next Page / Last Page / Zurück-Exit
 *   (Exit nur in der Wurzel, sonst Zurück - siehe bubble-menu.py build_entries())
 *
 * In Unterordnern (und den virtuellen Alle-Apps-/Programme-Listen) füllen
 * sich Spalte 1-4 stattdessen gleichmäßig zeilenweise mit bis zu 12
 * Einträgen pro Seite; reicht das nicht, blättert Next/Last Page.
 *
 * WICHTIG: flow: horizontal in listview sorgt dafür, dass rofi die
 * Einträge zeilenweise (links nach rechts) einsortiert - genau die
 * Reihenfolge, in der bubble-menu.py sie liefert. Ohne das würde die
 * Nav-Spalte (5) nicht zuverlässig ganz rechts landen.
 *
 * Assets (lege sie in ~/.config/rofi/assets/ ab):
 *   bubble-normal.png   → dunkle lila Blase (inaktiv)
 *   bubble-selected.png → helle/leuchtende Blase (aktiv)
 *
 * ── SCALING-FIX ─────────────────────────────────────────
 * Rofi kennt "px" (rohe, physische Bildschirm-Pixel - reagiert NICHT auf
 * -dpi) und "mm" (physische Größe, wird aus dem aktuellen -dpi-Wert
 * berechnet: px = mm * dpi / 25.4 - reagiert also 1:1 wie der Text).
 * Alle Layout-Werte hier sind deshalb von px auf mm umgerechnet, damit
 * sie exakt so mitskalieren wie die Schrift, wenn hyprland.lua per
 * "-dpi $(hyprctl ...)" den DPI-Wert dynamisch setzt.
 *
 * Umrechnung (Basis: 96 DPI = Faktor 1.0, also identisch zu vorher):
 *   mm = px_original * 25.4 / 96
 * Alle Werte unten sind 1:1 aus der Original-Datei übernommen,
 * NUR die Einheit wurde geändert - keine Zahl wurde "korrigiert".
 */

configuration {
    ml-row-right: "ScrollDown";
    ml-row-left:  "ScrollUp";
    ml-row-down:  "";
    ml-row-up:    "";
}

* {
    /* ── Farben ──────────────────────────────────── */
    bg-transparent:     rgba(0,0,0,0);
    text-normal:        rgba(220,210,255,1);
    text-selected:      rgba(255,255,255,1);
    text-shadow-color:  rgba(0,0,0,0.8);

    /* ── Pfade ───────────────────────────────────── */
    /* HIER ANPASSEN falls deine Assets woanders liegen */
    bubble-normal:      url("/tmp/bubble-normal.png",   both);
    bubble-selected:    url("/tmp/bubble-selected.png", both);

    /* ── Layout (in mm statt px, siehe SCALING-FIX oben) ── */
    /* 1080px @96dpi -> 285.75mm */
    cell-size:          285.75mm;
    columns:            5;
    rows:               3;
    cell-gap:           9.26mm;   /* 35px @96dpi */

    font:               "Sans Bold 8";
}

/* ── Fenster ─────────────────────────────────────────── */
window {
    transparency:       "real";
    background-color:   rgba(0,0,0,0);
    border:             0px;
    padding:            0px;
    /* Original: 1080px @96dpi -> 285.75mm */
    width: 285.75mm;
    max-width: 100%;
    location:           center;
    anchor:             center;
}

/* ── Kein Eingabefeld ────────────────────────────────── */
mainbox {
    background-color:   @bg-transparent;
    children:           [ listview ];
    padding:            9.26mm;   /* 35px @96dpi */
    spacing:            0px;
}

/* Eingabefeld komplett verstecken */
inputbar {
    enabled:            false;
}

/* ── Grid ────────────────────────────────────────────── */
listview {
    background-color:   @bg-transparent;
    columns:            @columns;
    lines:              @rows;
    flow:               horizontal;
    fixed-columns:      true;
    fixed-height:       false;
    scrollbar:          false;
    spacing:            @cell-gap;
    cycle:              false;
}

/* ── Jede Zelle (Blase) ──────────────────────────────── */
element {
    background-color:   @bg-transparent;
    background-image:   @bubble-normal;
    orientation:        vertical;
    padding:            9.26mm 9.26mm 9.26mm 9.26mm;   /* 35px @96dpi */
    border:             0px;
    cursor:             pointer;

    /* Erzwingt quadratische Zellen mit der definierten Größe */
    width:              @cell-size;
    height:             @cell-size;
}

element selected.normal,
element selected.urgent,
element selected.active {
    background-color:   @bg-transparent;
    background-image:   @bubble-selected;
}

/* ── Icon (App/Ordner-Icon innerhalb der Blase) ──────── */
element-icon {
    background-color:   @bg-transparent;
    size:               17.2mm;   /* 65px @96dpi */
    horizontal-align:   0.5;
    vertical-align:     0.5;
    /* Oben etwas Platz lassen damit Icon mittig-oben in der Blase sitzt */
    margin:             1.32mm 1.32mm 1.32mm 1.32mm;   /* 5px @96dpi */
}

/* ── Label ───────────────────────────────────────────── */
element-text {
    background-color:   @bg-transparent;
    text-color:         @text-normal;
    font:               @font;
    horizontal-align:   0.5;
    vertical-align:     0.1;
    /* Leichter Text-Schatten über expand: rofi kann keinen echten Schatten,
     *       aber ein etwas dunklerer Hint color verhindert Leseproblem */
    margin:             1.32mm 1.32mm 1.32mm 1.32mm;   /* 5px @96dpi */
}

element selected.normal element-text,
element selected.urgent element-text,
element selected.active element-text {
    text-color:         @text-selected;
}

/* ── Scrollbar (versteckt) ───────────────────────────── */
scrollbar {
    enabled:            false;
    width:              0px;
}
