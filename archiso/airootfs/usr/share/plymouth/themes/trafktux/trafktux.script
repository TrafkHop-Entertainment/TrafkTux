# TrafkTux Plymouth Theme
# v4 - Logo braucht "cover"-Skalierung (MAX), nicht "contain" (MIN), um
# GRUBs tatsaechliches Bucket-Verhalten nachzubilden (Canvas zuschneiden
# + strecken = rechnerisch "cover"). Vignette/Hintergrund bleiben voller
# Stretch wie bei GRUBs geteilten Layern. Blase so weit hochgesetzt, dass
# ihr unterer Rand nicht mehr ueber den Bildschirmrand hinausragt.
#
# Verwendet direkt die GRUB-Assets (GrubLayer1/2/5.png), keine separate
# Plymouth-Kopie mehr - ein Satz Dateien, keine Drift-Gefahr zwischen
# GRUB- und Plymouth-Optik.
#
#   Z=0   Hintergrund (GrubLayer5.png, Sternenhimmel) - voller Stretch
#   Z=3   animierte Blase (Fortschrittsanzeige)
#   Z=4   Vignette (GrubLayer2.png) - voller Stretch
#   Z=10  Logo (GrubLayer1.png) - "cover", ganz oben
#
# Reihenfolge/Z hier zaehlt zuverlaessig (SetZ()), anders als bei GRUBs
# +image-Deklarationsreihenfolge - kein Rate-Theater noetig.

# ── Hintergrundfarbe als Fallback (falls Bild mal nicht laedt) ──
Window.SetBackgroundTopColor(0.1373, 0.0863, 0.2314);
Window.SetBackgroundBottomColor(0.1020, 0.0510, 0.2039);

win_w = Window.GetWidth();
win_h = Window.GetHeight();

# ── Hilfsfunktion: voller Stretch auf Fensterbreite UND -hoehe, genau
# wie GRUBs width=100%/height=100% fuer die geteilten Layer (Vignette,
# Hintergrund) - dort faellt eine minimale Verzerrung bei abweichendem
# Seitenverhaeltnis kaum auf, deswegen kein Aufwand mit Scale-Berechnung.
fun make_stretched_sprite(filename, z) {
    raw = Image(filename);
    scaled = raw.Scale(win_w, win_h);
    sprite = Sprite(scaled);
    sprite.SetX(0);
    sprite.SetY(0);
    sprite.SetZ(z);
    return sprite;
}

# ── Hilfsfunktion: "cover" - Bild uniform so gross skalieren, dass es
# den ganzen Screen abdeckt (ueberstehender Rand faellt ausserhalb des
# sichtbaren Fensters weg, Plymouth zeichnet dort nichts - kein
# expliziter Crop noetig). Das entspricht rechnerisch exakt dem, was
# GRUBs Bucket-System fuer den Logo-Layer tatsaechlich tut: Canvas vorher
# auf Ziel-Aspect-Ratio zuschneiden, dann komplett auf den Bildschirm
# strecken = mathematisch identisch zu "cover". Deswegen hier MAX statt
# MIN der beiden Verhaeltnisse (contain/MIN war der Denkfehler, der die
# ~11% Groessenabweichung zu GRUB verursacht hat).
fun make_cover_sprite(filename, z) {
    raw = Image(filename);
    ratio_w = win_w / raw.GetWidth();
    ratio_h = win_h / raw.GetHeight();
    if (ratio_w > ratio_h) {
        scale = ratio_w;
    } else {
        scale = ratio_h;
    }
    new_w = Math.Int(raw.GetWidth() * scale);
    new_h = Math.Int(raw.GetHeight() * scale);
    scaled = raw.Scale(new_w, new_h);
    sprite = Sprite(scaled);
    sprite.SetX((win_w - new_w) / 2);
    sprite.SetY((win_h - new_h) / 2);
    sprite.SetZ(z);
    return sprite;
}

# ── Hintergrund: Sternenhimmel, volle Breite+Hoehe (wie GRUB) ─────────
bg_sprite = make_stretched_sprite("GrubLayer5.png", 0);

# ── Vignette: volle Breite+Hoehe (wie GRUB) ───────────────────────────
vignette_sprite = make_stretched_sprite("GrubLayer2.png", 4);

# ── Animierte Blase (Fortschrittsanzeige) ─────────────────────────────
frame_files = [
    "0001.png", "0031.png", "0061.png", "0091.png",
    "0121.png", "0151.png", "0181.png", "0211.png",
    "0241.png", "0271.png", "0301.png", "0331.png",
    "0361.png", "0391.png", "0421.png", "0451.png"
];
frame_count = 16;

# Referenz war 1920x1080, bubble_canvas_size=550px (≈50.9% der Hoehe),
# bubble_center_y=950px (≈88.0% der Hoehe) - das ergab damals schon
# rechnerisch 950+550/2=1225px, ueber der 1080px-Referenzhoehe hinaus
# (13% Ueberstand unten), unabhaengig von der tatsaechlichen Aufloesung.
# Center_y hier etwas raufgesetzt, damit der untere Rand der Blase genau
# auf 98% der Fensterhoehe landet statt drueber hinaus - Zahlen anpassen
# = einfach die beiden Faktoren aendern, keine Neuberechnung noetig.
bubble_size_fraction = 0.509;
bubble_bottom_edge_fraction = 0.98;
bubble_center_y_fraction = bubble_bottom_edge_fraction - (bubble_size_fraction / 2);

# Korrekturfaktor fuer die tatsaechlich SICHTBARE Groesse der Blase.
# bubble_size_fraction legt die Canvas-Groesse fest, nicht die Groesse
# des sichtbaren Kreises im Bild. Die neuen Frames (0001.png etc.) haben
# kaum Transparenz-Rand - der Kreis fuellt die Canvas zu ~95% statt wie
# bei den alten Bildern nur teilweise. Deshalb wirkt die Blase bei
# gleichem bubble_size_fraction jetzt groesser. < 1.0 = kleiner,
# 1.0 = keine Korrektur. Einfach diesen einen Wert nachtunen, falls
# noch zu gross/klein - Position (bottom edge) bleibt dabei unveraendert,
# da bubble_center_y weiter unten ueber die (unveraenderte) Fraction
# berechnet wird.
bubble_visual_scale = 0.8;

bubble_canvas_size = Math.Int(win_h * bubble_size_fraction * bubble_visual_scale);

bubble_frame = [];
for (i = 0; i < frame_count; i++) {
    raw = Image(frame_files[i]);
    bubble_frame[i] = raw.Scale(bubble_canvas_size, bubble_canvas_size);
}

bubble_sprite = Sprite(bubble_frame[0]);
bubble_sprite.SetZ(3);

bubble_w = bubble_frame[0].GetWidth();
bubble_h = bubble_frame[0].GetHeight();

bubble_center_y = win_h * bubble_center_y_fraction;
bubble_y = bubble_center_y - bubble_h / 2;

start_x  = -bubble_w;
end_x    = win_w;

bubble_sprite.SetY(bubble_y);
bubble_sprite.SetX(start_x);

spin_tick = 0;
# 50Hz angenommen (wie im alten Theme), 16 Frames = 1 volle Umdrehung,
# Zieldauer 1s/Umdrehung -> 50/16 = 3.125, gerundet auf 3 Ticks pro Frame
# (ergibt ~0.96s/Umdrehung, nah genug an 1s). Bei Bedarf hier direkt tunen.
ticks_per_frame = 3;

# Laeuft unabhaengig vom Boot-Fortschritt weiter, damit die Animation
# auch bei Boot-Haengern nicht einfriert.
fun refresh_callback() {
    spin_tick++;
    if (spin_tick >= frame_count * ticks_per_frame) {
        spin_tick = 0;
    }
    bubble_sprite.SetImage(bubble_frame[Math.Int(spin_tick / ticks_per_frame)]);
}
Plymouth.SetRefreshFunction(refresh_callback);

# Horizontale Position an den echten Boot-Fortschritt (0..1) gekoppelt.
fun progress_callback(duration, progress) {
    x = start_x + (end_x - start_x) * progress;
    bubble_sprite.SetX(x);
}
Plymouth.SetBootProgressFunction(progress_callback);

# ── Logo: "cover"-Skalierung, mittig, ganz oben - reproduziert GRUBs
# effektives Bucket-Verhalten (Canvas zuschneiden + strecken = "cover"),
# ohne selbst Buckets/vorgeformte Canvases zu brauchen. ───────────────
logo_sprite = make_cover_sprite("GrubLayer1.png", 10);
