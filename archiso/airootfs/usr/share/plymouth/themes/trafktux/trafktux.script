# TrafkTux Plymouth Theme
# v2 - umgestellt auf dieselben fertig kompositierten Ebenen wie das
# GRUB-Theme: ein Foreground (Vignette+Logo) und ein Background
# (Sternenhimmel), beide 1920x1080 und einfach als Vollbild-Sprites
# uebereinander gelegt. Anders als bei GRUB gibt's hier kein
# Stapel-Bug-Theater: Plymouth stapelt zuverlaessig ueber SetZ().
#
#   Z=0   Background (PlymouthLayer3.png, Sternenhimmel)
#   Z=5   animierte Blase (Fortschrittsanzeige)
#   Z=10  Foreground (PlymouthLayer1.png, Vignette + Logo, ganz oben)
#
# Kein separater Divider mehr - der ist im neuen Foreground-Layer
# schon mit drin (genau wie beim GRUB-Theme).

# ── Hintergrundfarbe als Fallback (falls Bild mal nicht laedt) ──
Window.SetBackgroundTopColor(0.1373, 0.0863, 0.2314);
Window.SetBackgroundBottomColor(0.1020, 0.0510, 0.2039);

# ── Background: Sternenhimmel, volle Screen-Groesse ──────────────
bg_raw = Image("PlymouthLayer3.png");
bg_image = bg_raw.Scale(Window.GetWidth(), Window.GetHeight());
bg_sprite = Sprite(bg_image);
bg_sprite.SetX(0);
bg_sprite.SetY(0);
bg_sprite.SetZ(0);

# ── Animierte Blase (Fortschrittsanzeige) ─────────────────────────
# 30 Frames (jeder 16. von urspruenglich 479 bei 60fps), damit die
# tatsaechliche Umlaufzeit (~8s) gleich bleibt.
frame_files = [
    "0001.png", "0017.png", "0033.png", "0049.png", "0065.png",
    "0081.png", "0097.png", "0113.png", "0129.png", "0145.png",
    "0161.png", "0177.png", "0193.png", "0209.png", "0225.png",
    "0241.png", "0257.png", "0273.png", "0289.png", "0305.png",
    "0321.png", "0337.png", "0353.png", "0369.png", "0385.png",
    "0401.png", "0417.png", "0433.png", "0449.png", "0465.png"
];
frame_count = 60;

# Die Rohbilder sind 2160x2160 und ziemlich gross (nur ca. 54% davon
# ist die sichtbare Blase, Rest ist Rand fuer die Animation) - darum
# hier im Skript auf die gewuenschte Bildschirmgroesse runterskaliert.
# bubble_canvas_size ist die Zielgroesse des GESAMTEN (noch mit Rand
# behafteten) Bildes - die sichtbare Blase selbst wird dadurch ca.
# 54% davon, hier also ca. 297px. Falls doch noch groesser/kleiner
# gewuenscht, einfach diese eine Zahl aendern.
bubble_canvas_size = 550;

bubble_frame = [];
for (i = 0; i < frame_count; i++) {
    raw = Image(frame_files[i]);
    bubble_frame[i] = raw.Scale(bubble_canvas_size, bubble_canvas_size);
}

bubble_sprite = Sprite(bubble_frame[0]);
bubble_sprite.SetZ(5);

bubble_w = bubble_frame[0].GetWidth();
bubble_h = bubble_frame[0].GetHeight();

# Nicht mehr am Bildschirmrand verankert, sondern vertikal mittig im
# Raum UNTER dem Logo (Logo inkl. Glow reicht bis y~299 bei 1080px
# Hoehe -> Mitte des Rests = ca. y=690). Bei Bedarf einfach
# bubble_center_y anpassen.
bubble_center_y = 950;
bubble_y = bubble_center_y - bubble_h / 2;

start_x  = -bubble_w;
end_x    = Window.GetWidth();

bubble_sprite.SetY(bubble_y);
bubble_sprite.SetX(start_x);

spin_tick = 0;
# 50Hz angenommen (wie im alten Theme) * ~8s Zieldauer / 30 Frames
# ≈ 13 Ticks pro Frame. Bei Bedarf hier direkt tunen.
ticks_per_frame = 13;

# Laeuft unabhaengig vom Boot-Fortschritt weiter, damit die Animation
# auch bei Boot-Haengern nicht einfriert.
fun refresh_callback() {
    spin_tick++;
    if (spin_tick >= frame_count * ticks_per_frame) {
        spin_tick = 0;
    }
    bubble_sprite.SetImage(bubble_frame[Math.Int(spin_tick / ticks_per_frame)]);
}
Plymouth.SetRefreshFunction(refresh_callback);

# Horizontale Position an den echten Boot-Fortschritt (0..1) gekoppelt.
fun progress_callback(duration, progress) {
    x = start_x + (end_x - start_x) * progress;
    bubble_sprite.SetX(x);
}
Plymouth.SetBootProgressFunction(progress_callback);

# ── Foreground: Vignette + Logo, oberste Ebene ────────────────────
fg_raw = Image("PlymouthLayer1.png");
fg_image = fg_raw.Scale(Window.GetWidth(), Window.GetHeight());
fg_sprite = Sprite(fg_image);
fg_sprite.SetX(0);
fg_sprite.SetY(0);
fg_sprite.SetZ(10);
